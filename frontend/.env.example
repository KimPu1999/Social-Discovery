# API base URL. Leave unset to use the Vite dev proxy (same-origin /api/v1,
# recommended). Set an absolute URL only when the API lives on a different host.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional. Footer social links are only rendered when provided; no accounts are invented.
# VITE_SOCIAL_LINKS=[{"label":"Blog","url":"https://example.com/blog"}]
